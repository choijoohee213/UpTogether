  m_Script: {fileID: 11500000, guid: f99a31c1dde514f9c86e7efabc44aaa9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UpTogether::UpTogether.Narration
  lines:
  - meters: 10
    text: "\uAC15\uC544\uC9C0\uAC00 \uC885\uC885\uAC78\uC74C\uC73C\uB85C \uB530\uB77C\uC628\uB2E4."
  - meters: 28
    text: "\uB4A4\uB3CC\uC544\uBCF4\uB2C8 \uAC15\uC544\uC9C0\uAC00 \uBC1C\uD310 \uB05D\uC5D0\uC11C \uB9DD\uC124\uC774\uACE0 \uC788\uB2E4."
  - meters: 48
    text: "\uC774\uC81C\uB294 \uB124\uAC00 \uB6F0\uAE30 \uC804\uC5D0 \uAC15\uC544\uC9C0\uAC00 \uBA3C\uC800 \uC790\uC138\uB97C \uC7A1\uB294\uB2E4."
  - meters: 72
    text: "\uB5A8\uC5B4\uC9C8 \uB54C\uB9C8\uB2E4 \uAC19\uC774 \uB5A8\uC5B4\uC838 \uC92C\uB2E4\uB294 \uAC78 \uC54C\uACE0 \uC788\uB2E4."
  - meters: 100
    text: "\uAC15\uC544\uC9C0\uAC00 \uC55E\uC7A5\uC11C\uC11C \uBC1C\uD310\uC744 \uD655\uC778\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - meters: 130
    text: "\uB458 \uB2E4 \uC228\uC774 \uCC28\uC9C0\uB9CC \uC544\uBB34\uB3C4 \uBA48\uCD94\uC790\uACE0 \uD558\uC9C0 \uC54A\uB294\uB2E4."
